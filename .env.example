# Tebex Headless public token
# creator.tebex.io → your Java Edition project → Developers → API keys → Public token
VITE_TEBEX_PUBLIC_TOKEN=

# Classic webstore URL (optional fallback if Headless is not used)
# Example: https://astra.tebex.io
VITE_TEBEX_STORE_URL=

# Package slug for the full cloak collection. Price: 8.99 USD
# Create it in Packages → Add New → Package:
#   Name: Unlock Entire Collection
#   Price: 8.99 USD, one-time (not subscription)
#   Custom URL slug: collection
#   Purchase limits → Global limit: 100, period never / lifetime
#   Purchase limits → User limit: 1, period never / lifetime
#   Restrictions → Quantity lock: on (buyers cannot buy 2 copies)
VITE_TEBEX_COLLECTION_SLUG=collection

# Store admin password (server only — not VITE_). Used at /store for the corner admin box.
# Must be at least 8 characters. Admin sessions use an HttpOnly cookie.
ADMIN_PASSWORD=

# Creator panel → Developers → Webhooks → Endpoints. Paste the endpoint secret here
# (and as a Cloudflare Worker secret named TEBEX_WEBHOOK_SECRET).
TEBEX_WEBHOOK_SECRET=

# Optional production cosmetics API (same routes as the local Vite store middleware).
# GitHub Pages cannot run /api itself. Set this to the Cloudflare Worker URL, for example:
# VITE_STORE_API=https://astra-store.your-account.workers.dev/api
VITE_STORE_API=

# Create one package per paid cloak at 3.99 USD. The slug MUST match:
#   torii, gojo, ash, goated, shadow, spidey, swag, benjamin, void,
#   monster, cross, youdied, default, tuff, happens,
#   ilove189, enderman, wither, creeper, steve, cat, blep,
#   boom, hamster, glassstar, unoreverse, irl, aura, miku, muichiro, itadori
# Package names should be like "Uno Reverse cloak" / "Dollar cloak".
# Free (do not sell on Tebex): astraclient (Eclipse), ilove
# Removed from the store: astra, astralogo, crystal
# Plus one bundle package:
#   slug: collection    name: Unlock Entire Collection    price: 8.99 USD
#   Global purchase limit 100, user limit 1, quantity locked
