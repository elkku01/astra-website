# ---- Payments: Stripe Managed Payments (Stripe is the merchant of record: it
# collects and pays VAT / sales tax, handles fraud, disputes and payment support).
# All three are server-only. Never put them in a VITE_ variable.

# Stripe Dashboard -> Developers -> API keys -> Secret key (sk_test_... while testing, sk_live_... for real sales)
STRIPE_SECRET_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret (whsec_...)
# Endpoint URL: https://<your store worker>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Where Stripe sends buyers back after paying (local dev: http://localhost:5173)
SITE_URL=http://localhost:5173

# Store admin password (server only). Used at /store for the corner admin box. At least 8 characters.
ADMIN_PASSWORD=

# Production store API (the Cloudflare Worker). GitHub Pages cannot run /api itself.
# Example: https://astra-store.<your-subdomain>.workers.dev/api
VITE_STORE_API=
